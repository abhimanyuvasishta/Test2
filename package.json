{
  "name": "client-video-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma db push && next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && prisma db push && next build",
    "build:pages": "bash scripts/build-pages.sh",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "render:sample": "tsx scripts/render-sample.ts",
    "postinstall": "DATABASE_URL=file:./prisma/dev.db prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.5",
    "openai": "^4.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.8"
  }
}
